{
  "manifest_version": 3,
  "name": "Focus Mode — Anti-Doomscroll",
  "version": "1.2.0",
  "description": "Blocks infinite-scroll and short-form video traps on Instagram, YouTube, Twitter/X, Reddit, and LinkedIn — with schedules, time budgets, and mindful-use nudges.",

  "browser_specific_settings": {
    "gecko": {
      "id": "focusMode@noodler",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg"
    },
    "default_title": "Focus Mode"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "alarms",
    "scripting",
    "activeTab",
    "notifications"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "*://*.linkedin.com/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["css/global.css", "css/instagram.css"],
      "js": [
        "content-scripts/common.js",
        "content-scripts/friction.js",
        "content-scripts/custom-blocker.js",
        "content-scripts/instagram.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["css/global.css", "css/youtube.css"],
      "js": [
        "content-scripts/common.js",
        "content-scripts/friction.js",
        "content-scripts/custom-blocker.js",
        "content-scripts/youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://twitter.com/*", "*://*.twitter.com/*",
        "*://x.com/*", "*://*.x.com/*"
      ],
      "css": ["css/global.css", "css/twitter.css"],
      "js": [
        "content-scripts/common.js",
        "content-scripts/friction.js",
        "content-scripts/custom-blocker.js",
        "content-scripts/twitter.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "css": ["css/global.css", "css/reddit.css"],
      "js": [
        "content-scripts/common.js",
        "content-scripts/friction.js",
        "content-scripts/custom-blocker.js",
        "content-scripts/reddit.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "css": ["css/global.css", "css/linkedin.css"],
      "js": [
        "content-scripts/common.js",
        "content-scripts/friction.js",
        "content-scripts/custom-blocker.js",
        "content-scripts/linkedin.js"
      ],
      "run_at": "document_start"
    }
  ]
}
